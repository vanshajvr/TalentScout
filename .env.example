# Copy to .env for local development. Never commit the real .env.

# Postgres connection. Any scheme works (postgres://, postgresql://,
# postgresql+psycopg://) — db/database.py normalizes it to the psycopg 3 driver.
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/talentscout

# Groq API key, used for resume/JD extraction, behavioral questions, and the
# open-text judge. https://console.groq.com/keys
GROQ_API_KEY=

# Tests only (put these in .env.test). Must point at a separate, disposable
# database — conftest.py refuses to run if it matches DATABASE_URL.
# TEST_DATABASE_URL=postgresql://postgres:devpass@localhost:5432/talentscout_test
